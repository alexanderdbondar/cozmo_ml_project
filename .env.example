# Cozmo ML Project Environment Variables (Optional / Local Execution)

# Cozmo Robot Wi-Fi Connection Settings
# Default Cozmo Access Point IP is 172.31.1.1
COZMO_IP=YOUR_COZMO_IP_HERE
COZMO_PORT=YOUR_COZMO_PORT_HERE

# Model & Data Paths (Defaults to current working directory if omitted)
DATASET_PATH=YOUR_DATASET_PATH_HERE
MODEL_PATH=YOUR_MODEL_PATH_HERE
